#include <sys/mman.h>
#include <unistd.h>
#include <stdlib.h>
#include <stdio.h>

char *solution();
void install_seccomp();

int main(int argc, char **argv)
{
	install_seccomp();

	int shm_fd = -1;
	off_t shm_size = -1;

	if (argc < 3) {
		goto err_out;
	}

	shm_fd = atoi(argv[1]);
	shm_size = atoi(argv[2]);

	char *shm_ptr = mmap(NULL, shm_size, PROT_READ | PROT_WRITE, MAP_SHARED, shm_fd, 0);
	if (shm_ptr == MAP_FAILED) {
		goto err_out;
	}

	char *res = solution();

	int ch;
	int r,w;
	r = w = 0;
	while ((ch = res[r++]) != '\0' && ch != EOF && r < 100) {
		shm_ptr[w++] = ch;
	}
	shm_ptr[w++] = '\n'; // the file doesn't need \0 ending. But most of case it will have \n

	munmap(shm_ptr, shm_size);
	close(shm_fd); shm_fd = -1;

	return 0;

err_out:
	if (shm_fd >= 0) {
		close(shm_fd); shm_fd = -1;
	}

	return -1;
}
